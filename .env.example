# Copy the lines you need into your .env file (same folder) and paste your own keys.
# Every key is optional: providers without a key are simply skipped.
# Never share keys or commit .env to GitHub.

GEMINI_API_KEY=        # aistudio.google.com
GROQ_API_KEY=          # console.groq.com
CEREBRAS_API_KEY=      # cloud.cerebras.ai
OPENROUTER_API_KEY=    # openrouter.ai/keys  (use models ending in :free)
MISTRAL_API_KEY=       # console.mistral.ai  (free "Experiment" plan)
GITHUB_TOKEN=          # github.com/settings/tokens  (fine-grained token, "Models" read permission)
HF_TOKEN=              # huggingface.co/settings/tokens
# Ollama needs no key: it runs on this laptop.
